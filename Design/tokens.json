{
  "$schema": "StudyFlow design tokens — mirrors the CSS custom properties in styles.css. Keep both in sync by hand; this file has no build step.",
  "color": {
    "bg": { "value": "#f7f7f4", "cssVar": "--color-bg", "usage": "Fundo de página" },
    "surface": { "value": "#ffffff", "cssVar": "--color-surface", "usage": "Cards, tabela, modais" },
    "surfaceStrong": { "value": "#e6e5e0", "cssVar": "--color-surface-strong", "usage": "Fundo de badge neutro" },
    "border": { "value": "#e6e5e0", "cssVar": "--color-border", "usage": "Divisórias e contornos de cards/tabela" },
    "borderStrong": { "value": "#807d72", "cssVar": "--color-border-strong", "usage": "Contorno de inputs/botões/paginação (ajustado para contraste >=3:1, original do DESIGN-cursor.md era #cfcdc4)" },
    "textPrimary": { "value": "#26251e", "cssVar": "--color-text-primary", "usage": "Títulos, corpo, valores de tabela" },
    "textSecondary": { "value": "#5a5852", "cssVar": "--color-text-secondary", "usage": "Subtítulos, rótulos de cabeçalho, legendas" },
    "textTertiary": { "value": "#807d72", "cssVar": "--color-text-tertiary", "usage": "Somente decorativo (ícones, placeholder) — não usar como texto essencial" },
    "textDisabled": { "value": "#a09c92", "cssVar": "--color-text-disabled", "usage": "Controles desabilitados" },
    "primary": { "value": "#f54e00", "cssVar": "--color-primary", "usage": "Botão \"Novo\", destaque do item ativo do menu" },
    "primaryPressed": { "value": "#d04200", "cssVar": "--color-primary-pressed", "usage": "Estado :active do botão primário" },
    "primarySoft": { "value": "#fde4d8", "cssVar": "--color-primary-soft", "usage": "Fundo do item ativo do menu" },
    "onPrimary": { "value": "#ffffff", "cssVar": "--color-on-primary", "usage": "Texto/ícone sobre fundo primário" },
    "error": { "value": "#cf2d56", "cssVar": "--color-error", "usage": "Botão/texto \"Excluir\", validação" },
    "errorSoft": { "value": "#fbe3e9", "cssVar": "--color-error-soft", "usage": "Hover de ação destrutiva" },
    "success": { "value": "#1f8a65", "cssVar": "--color-success", "usage": "Indicadores de confirmação" },
    "successSoft": { "value": "#dff1e9", "cssVar": "--color-success-soft", "usage": "Reservado para fundos de sucesso" }
  },
  "typography": {
    "fontFamily": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif", "cssVar": "--font-sans" },
    "pageTitle": { "fontSize": 28, "fontWeight": 400, "letterSpacing": "-0.02em", "usage": "H1 de página" },
    "componentTitle": { "fontSize": 18, "fontWeight": 600, "letterSpacing": "0", "usage": "Títulos de modal/componente" },
    "button": { "fontSize": 14, "fontWeight": 500, "letterSpacing": "0", "usage": "Botões e itens de menu" },
    "body": { "fontSize": 16, "fontWeight": 400, "lineHeight": 1.5, "usage": "Corpo, subtítulos" },
    "tableBody": { "fontSize": 14, "fontWeight": 400, "usage": "Células da tabela" },
    "tableHeader": { "fontSize": 11, "fontWeight": 600, "letterSpacing": "0.06em", "textTransform": "uppercase", "usage": "Cabeçalho de tabela" },
    "caption": { "fontSize": 13, "fontWeight": 400, "usage": "Legendas, contador de registros" }
  },
  "radius": {
    "sm": { "value": "6px", "cssVar": "--radius-sm", "usage": "Linhas compactas" },
    "md": { "value": "8px", "cssVar": "--radius-md", "usage": "Botões, campos de texto" },
    "lg": { "value": "12px", "cssVar": "--radius-lg", "usage": "Cards, área da tabela" },
    "pill": { "value": "9999px", "cssVar": "--radius-pill", "usage": "Badges" }
  },
  "spacing": {
    "1": { "value": "4px", "cssVar": "--space-1" },
    "2": { "value": "8px", "cssVar": "--space-2" },
    "3": { "value": "12px", "cssVar": "--space-3" },
    "4": { "value": "16px", "cssVar": "--space-4" },
    "5": { "value": "20px", "cssVar": "--space-5" },
    "6": { "value": "24px", "cssVar": "--space-6" },
    "7": { "value": "28px", "cssVar": "--space-7" },
    "8": { "value": "32px", "cssVar": "--space-8" },
    "10": { "value": "40px", "cssVar": "--space-10" },
    "12": { "value": "48px", "cssVar": "--space-12" }
  },
  "layout": {
    "sidebarExpanded": { "value": "248px", "cssVar": "--sidebar-w-expanded" },
    "sidebarCollapsed": { "value": "72px", "cssVar": "--sidebar-w-collapsed" },
    "topbarHeight": { "value": "56px", "cssVar": "--topbar-h" },
    "breakpoints": { "mobile": 375, "tablet": 768, "desktop": 1024, "wide": 1440 }
  },
  "motion": {
    "fast": { "value": "150ms ease-out", "cssVar": "--transition-fast", "usage": "Hover, pequenas transições" },
    "base": { "value": "200ms ease-out", "cssVar": "--transition-base", "usage": "Drawer, overlays" }
  },
  "elevation": {
    "note": "Sem sombras em todo o sistema — profundidade apenas por bordas finas de 1px (--color-border / --color-border-strong)."
  }
}
