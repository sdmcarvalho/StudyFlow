DATABASE_URL="file:./prisma/dev.db"
# Pasta base dos Estudos (opcional; padrão C:\StudyFlow). O seed cria <base>\<nome> e o modal de
# novo Estudo sugere <base>\ no campo Pasta.
# STUDYFLOW_BASE_DIR="C:\StudyFlow"
# Linux (VPS):
# STUDYFLOW_BASE_DIR="/var/lib/studyflow"

# Em produção (Linux) use caminho ABSOLUTO para o banco, fora da pasta do código. O padrão relativo
# acima ("file:./prisma/dev.db") é só para o desenvolvimento no Windows.
# DATABASE_URL="file:/opt/studyflow-data/studyflow.db"

# Superusuário inicial (usados só por `npm run auth:bootstrap`, que cria o único SUPER ou converte o usuário local antigo; nunca atualiza um SUPER que já existe).
# Depois do bootstrap, remova SUPERUSER_PASSWORD deste arquivo. A senha precisa ter ao menos 8 caracteres, com letra e número. Não existe AUTH_SECRET.
# SUPERUSER_EMAIL="admin@exemplo.com"
# SUPERUSER_PASSWORD="troque-esta-senha-1"
# SUPERUSER_NAME="Administrador"

# IA: por padrão o servidor só chama gateways em https cujo nome resolve SOMENTE para endereços públicos
# (bloqueia localhost, redes privadas, link-local/metadados da nuvem, CGNAT etc., contra SSRF).
# Use 1 apenas no computador de desenvolvimento, para um gateway local (ex.: http://localhost:11434/v1).
# Nunca ligue na VPS pública.
# STUDYFLOW_AI_ALLOW_PRIVATE="1"
