DATABASE_URL="file:./prisma/dev.db"
# Pasta base dos Estudos (opcional; padrão C:\StudyFlow). O seed cria <base>\<nome> e o modal de
# novo Estudo sugere <base>\ no campo Pasta.
# STUDYFLOW_BASE_DIR="C:\StudyFlow"

# Superusuário inicial (usados só por `npm run auth:bootstrap`, que cria/atualiza o único SUPER).
# A senha precisa ter ao menos 8 caracteres, com letra e número. Não existe AUTH_SECRET.
# SUPERUSER_EMAIL="admin@exemplo.com"
# SUPERUSER_PASSWORD="troque-esta-senha-1"
# SUPERUSER_NAME="Administrador"
